{
  "$schema": "https://loom.gadicc.local/project-manifest.schema.json",
  "version": 1,
  "project": {
    "name": "magickli",
    "framework": {
      "kind": "nextjs",
      "router": "app",
      "srcDir": true
    },
    "tooling": {
      "dependencies": {
        "config": "package.json",
        "manager": "pnpm"
      },
      "tasks": {
        "config": "package.json",
        "runner": "pnpm"
      }
    }
  },
  "features": {
    "auth": {
      "status": "active",
      "activatedOn": "2026-09-18",
      "config": {
        "entrypoints": {
          "routeHandler": "src/app/api/auth/[...nextauth]/route.ts",
          "signInPage": "src/app/signin/page.tsx"
        },
        "modules": {
          "authClientModule": "src/auth/client.ts",
          "authModule": "src/auth/sqlAuth.ts",
          "authRuntimeModule": "src/auth/runtime.ts",
          "authServerModule": "src/auth/session.ts"
        },
        "requestSessionReaders": "app-owned"
      }
    },
    "files": {
      "status": "active",
      "config": {
        "entrypoints": {
          "routeHandler": "src/app/api/files/route.ts"
        },
        "modules": {
          "accessModule": "src/files/access.ts",
          "repositoryModule": "src/files/repository.ts",
          "storageModule": "src/files/storage.ts"
        },
        "schema": {
          "blueprint": "files",
          "exports": ["loomFilesTable"],
          "idGeneration": "uuid-v7",
          "mode": "managed-local",
          "module": "src/db/schema/loomFiles.ts",
          "tableName": "loom_files",
          "version": 3,
          "hash": "f5d9773b3245df85231782ee42d292823bd6b474b406efa1c97a41bea7ac9bcf"
        },
        "storage": {
          "adapter": "custom",
          "provider": {
            "accessMode": "private",
            "accountId": "6fb830ebb3c8fed82a52524211d9c54e",
            "buckets": {
              "production": "magickli-files-production",
              "preview": "magickli-files-preview"
            },
            "connectionStatus": "configured",
            "credentialMode": "manual",
            "directBrowserAccess": true,
            "directUpload": {
              "kind": "presigned-put",
              "origins": {
                "production": ["https://magick.ly"],
                "preview": [
                  "https://magickly-preview-9fd4f93a-wastelands.vercel.app"
                ]
              },
              "allowedHeaders": [
                "content-type",
                "if-none-match",
                "x-amz-checksum-sha256",
                "x-amz-meta-magickli-file-id",
                "x-amz-meta-magickli-operation-id",
                "x-amz-meta-sha256"
              ],
              "maxAgeSeconds": 300
            },
            "forcePathStyle": true,
            "endpoint": "https://6fb830ebb3c8fed82a52524211d9c54e.r2.cloudflarestorage.com",
            "jurisdiction": "default",
            "kind": "cloudflare-r2",
            "localDevelopment": {
              "kind": "none"
            },
            "locationHint": "weur",
            "publicUrl": null,
            "vercelEnvironments": ["production", "preview"]
          }
        }
      },
      "activatedOn": "2026-09-13"
    },
    "db": {
      "status": "active",
      "activatedOn": "2026-09-12",
      "config": {
        "dirs": {
          "drizzleOutDir": "drizzle",
          "fixtureDir": "tests/fixtures/db",
          "schemaDir": "src/db/schema",
          "valibotGeneratedDir": "src/db/valibot/generated",
          "valibotRefinementsDir": "src/db/valibot/refinements"
        },
        "modules": {
          "drizzleConfig": "drizzle.config.ts",
          "fixtureDumpScript": "scripts/dump-test-tables.ts",
          "neonFullModule": "src/db/neonFull.ts",
          "neonModule": "src/db/neon.ts",
          "pgliteHarnessModule": "tests/memory-pglite.ts",
          "refinementsCommonModule": "src/db/valibot/refinements/_common.ts",
          "scriptsTsconfig": "scripts/tsconfig.scripts.json",
          "valibotBarrelModule": "src/db/valibot/index.ts"
        },
        "provider": {
          "connectionStatus": "connected",
          "development": false,
          "kind": "neon",
          "provisionedBy": "vercel-marketplace",
          "region": "lhr1",
          "resourceName": "magickli-db",
          "vercelEnvironments": ["production"]
        },
        "release": {
          "productionBranch": "master"
        }
      }
    }
  }
}
