{
  "name": "magickli",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^10.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "check:turbopack": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build --turbopack",
    "start": "next start",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "local-acceptance:seed": "loom env -- node --conditions=react-server --import tsx scripts/local-acceptance/seed.ts",
    "test:mongo": "MAGICKLI_RUN_MONGO_REHEARSAL=1 vitest run src/doc/writes.test.ts src/doc/gongoWrites.test.ts src/doc/writes.mongo.test.ts",
    "migration:legacy": "loom env -- node --import tsx scripts/legacy-import.ts",
    "db:fixtures": "loom db fixtures",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm drizzle-kit migrate",
    "db:push": "pnpm drizzle-kit push",
    "drizzle-kit": "NODE_OPTIONS='--import tsx' loom env -- drizzle-kit --config=./drizzle.config.ts",
    "schema:gen": "loom db schema-gen"
  },
